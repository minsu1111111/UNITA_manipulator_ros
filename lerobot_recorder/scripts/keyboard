#!/usr/bin/python3
"""`ros2 run lerobot_recorder keyboard` — lerobot-record 와 같은 녹화 조작.

    ros2 run lerobot_recorder keyboard --ros-args -p num_episodes:=10 -p episode_time_s:=30 -p reset_time_s:=10

recorder 노드(`ros2 run lerobot_recorder recorder` 또는 launch 의 record:=true)가 떠 있어야 한다.
lerobot-record 의 흐름을 그대로 따른다 (lerobot/scripts/lerobot_record.py, utils/keyboard_input.py):

    에피소드 녹화 (episode_time_s) → 환경 리셋 (reset_time_s, 녹화 안 함) → 다음 에피소드 … num_episodes 개까지
    마지막 에피소드 뒤에는 리셋을 건너뛴다.

    →  또는 n   지금 구간(녹화 또는 리셋)을 일찍 끝낸다
    ←  또는 r   방금 에피소드를 버리고 다시 녹화한다 (녹화 중이든 리셋 중이든)
    Esc 또는 q  지금 에피소드를 저장하고 녹화를 끝낸다

음성 안내도 lerobot 과 같다 ("Recording episode N", "Reset the environment", "Re-record episode", "Stop recording",
Linux 는 spd-say). -p play_sounds:=false 로 끈다.

lerobot 과 다른 점 하나: lerobot 은 Ctrl+C 를 누르면 녹화 중이던 에피소드를 저장하지 않지만, 여기서는 저장한다
(recorder 노드가 Ctrl+C 에 녹화 중 에피소드를 저장하므로 그것과 맞춤).

손으로 시작·저장하는 원래 키보드는 `ros2 run lerobot_recorder manual_keyboard`.
"""

import contextlib
import os
import platform
import re
import select
import signal
import subprocess
import sys
import termios
import threading
import time
import tty

import rclpy
from rcl_interfaces.msg import ParameterDescriptor
from rclpy.executors import SingleThreadedExecutor
from rclpy.node import Node
from rclpy.signals import SignalHandlerOptions
from std_srvs.srv import Trigger

HELP = "→/n: next   ←/r: re-record   Esc/q: stop recording"


# ----------------------------------------------------------------------------- lerobot 과 같은 음성
def say(text: str, play_sounds: bool, blocking: bool = False):
    """lerobot.utils.utils.say 와 같은 명령 (Linux 는 spd-say). 없거나 실패하면 조용히 넘어간다."""
    print(text, flush=True)
    if not play_sounds:
        return
    cmd = ["say", text] if platform.system() == "Darwin" else ["spd-say", text]
    if blocking and cmd[0] == "spd-say":
        cmd.append("--wait")
    with contextlib.suppress(FileNotFoundError, subprocess.TimeoutExpired, subprocess.CalledProcessError):
        if blocking:
            subprocess.run(cmd, check=True, timeout=5)
        else:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ----------------------------------------------------------------------------- 키 입력 (lerobot 과 같은 키)
class Events:
    """lerobot 의 events dict 와 같은 세 플래그 (keyboard_input.apply_recording_control)."""

    def __init__(self):
        self.exit_early = False
        self.rerecord_episode = False
        self.stop_recording = False

    def apply(self, control: str):
        if control == "right":
            print("\nRight arrow key pressed. Exiting loop...", flush=True)
            self.exit_early = True
        elif control == "left":
            print("\nLeft arrow key pressed. Exiting loop and rerecord the last episode...", flush=True)
            self.rerecord_episode = True
            self.exit_early = True
        elif control == "esc":
            print("\nEscape key pressed. Stopping data recording...", flush=True)
            self.stop_recording = True
            self.exit_early = True


class Keys:
    """터미널에서 키를 읽는다 (cbreak: 한 글자씩, Ctrl+C 는 그대로 SIGINT). 화살표 = ESC [ C/D 또는 ESC O C/D."""

    ARROWS = {"C": "right", "D": "left"}
    LETTERS = {"n": "right", "r": "left", "q": "esc"}

    def __init__(self):
        self.fd = sys.stdin.fileno()
        self.old = termios.tcgetattr(self.fd)
        tty.setcbreak(self.fd)

    def restore(self):
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old)

    def _read(self, timeout: float) -> str | None:
        r, _, _ = select.select([self.fd], [], [], timeout)
        return os.read(self.fd, 1).decode(errors="ignore") if r else None

    def poll(self, events: Events):
        while (c := self._read(0)) is not None:
            if c == "\x1b":
                nxt = self._read(0.05)  # 화살표는 바로 뒤에 [ 나 O 가 온다. 안 오면 Esc 하나
                if nxt in ("[", "O"):
                    control = self.ARROWS.get(self._read(0.05) or "")
                else:
                    control = "esc"
            else:
                control = self.LETTERS.get(c.lower())
            if control:
                events.apply(control)


# ----------------------------------------------------------------------------- recorder 서비스
class Controller(Node):
    def __init__(self):
        super().__init__("record_keyboard")
        any_num = ParameterDescriptor(dynamic_typing=True)  # -p episode_time_s:=30 (정수)도 받게
        # lerobot DatasetRecordConfig 기본값과 같다
        self.num_episodes = int(self.declare_parameter("num_episodes", 50).value)
        self.episode_time_s = float(self.declare_parameter("episode_time_s", 60.0, any_num).value)
        self.reset_time_s = float(self.declare_parameter("reset_time_s", 60.0, any_num).value)
        self.play_sounds = bool(self.declare_parameter("play_sounds", True).value)
        prefix = self.declare_parameter("recorder", "/episode_recorder").value
        self.clients_ = {
            name: self.create_client(Trigger, f"{prefix}/{name}")
            for name in ("start_recording", "stop_recording", "discard_episode", "delete_last_episode")
        }

    def wait_ready(self, timeout_s: float) -> bool:
        return all(c.wait_for_service(timeout_sec=timeout_s) for c in self.clients_.values())

    def call(self, name: str) -> tuple[bool, str]:
        fut = self.clients_[name].call_async(Trigger.Request())
        end = time.time() + 10
        while not fut.done() and time.time() < end:
            time.sleep(0.01)
        if not fut.done():
            return False, f"{name}: 응답 없음 (10 s)"
        res = fut.result()
        return res.success, res.message


def run_phase(label: str, duration_s: float, episode: str, keys: Keys, events: Events):
    """lerobot 의 record_loop 처럼 시간이 다 되거나 exit_early 가 켜질 때까지. 상태 줄을 갱신한다."""
    t0 = time.time()
    while time.time() - t0 < duration_s and not events.exit_early:
        keys.poll(events)
        dt = time.time() - t0
        mark = "\033[91m● REC  \033[0m" if label == "REC" else "\033[93m◌ RESET\033[0m"
        print(f"\r{mark} {episode}  {dt:5.1f} / {duration_s:.0f} s   [{HELP}]\033[K", end="", flush=True)
        time.sleep(0.05)
    print("\r\033[K", end="", flush=True)
    events.exit_early = False


def main():
    # rclpy 의 Ctrl+C 처리를 끈다 — 켜 두면 Ctrl+C 순간 ROS 통신이 먼저 닫혀서 녹화 중 에피소드를 저장 요청할 수 없다
    rclpy.init(signal_handler_options=SignalHandlerOptions.NO)
    node = Controller()
    ex = SingleThreadedExecutor()
    ex.add_node(node)
    spin = threading.Thread(target=ex.spin, daemon=True)
    spin.start()

    def close_ros():
        # spin 스레드를 먼저 멈추고 기다린다 — 돌고 있는 채로 rclpy 를 닫으면 C++ 쪽이 abort 한다
        with contextlib.suppress(Exception):
            ex.shutdown(timeout_sec=2)
        spin.join(timeout=2)
        with contextlib.suppress(Exception):
            node.destroy_node()
        with contextlib.suppress(Exception):
            rclpy.try_shutdown()

    print(
        f"[keyboard] recorder 서비스 기다리는 중 … ({node.clients_['start_recording'].srv_name})", flush=True
    )
    if not node.wait_ready(15):
        print(
            "[keyboard] recorder 가 없다 — `ros2 run lerobot_recorder recorder` 나 launch record:=true 를 먼저",
            flush=True,
        )
        close_ros()
        sys.exit(1)
    print(
        f"[keyboard] num_episodes={node.num_episodes}  episode_time_s={node.episode_time_s:g}  "
        f"reset_time_s={node.reset_time_s:g}  play_sounds={node.play_sounds}\n[keyboard] {HELP}",
        flush=True,
    )

    keys, events = Keys(), Events()
    recording = False
    recorded = 0
    sounds = node.play_sounds
    try:
        # ---- lerobot_record.py 의 에피소드 루프와 같은 순서 ----
        while recorded < node.num_episodes and not events.stop_recording:
            ok, msg = node.call("start_recording")
            if not ok:
                print(f"\n[keyboard] 녹화를 시작하지 못했다: {msg}", flush=True)
                break
            recording = True
            m = re.search(r"episode_(\d+)", msg)
            episode = f"episode_{m.group(1)}" if m else "episode"
            say(f"Recording episode {int(m.group(1)) if m else recorded}", sounds)
            run_phase("REC", node.episode_time_s, episode, keys, events)

            # 녹화 구간 끝: ← 가 눌렸으면 버리고, 아니면 저장한다 (Esc 도 저장)
            saved = False
            if events.rerecord_episode:
                node.call("discard_episode")
            else:
                saved, msg = node.call("stop_recording")
                if not saved:
                    print(f"\n[keyboard] 저장 실패: {msg}", flush=True)
            recording = False

            # 마지막 에피소드가 아니거나 다시 녹화할 거면 리셋 시간
            if not events.stop_recording and (recorded < node.num_episodes - 1 or events.rerecord_episode):
                say("Reset the environment", sounds)
                run_phase("RESET", node.reset_time_s, episode, keys, events)

            if events.rerecord_episode:  # 리셋 중에 ← 를 눌러도 여기로 온다
                if saved:
                    node.call("delete_last_episode")
                say("Re-record episode", sounds)
                events.rerecord_episode = False
                events.exit_early = False
                continue

            recorded += 1
            print(f"[keyboard] 저장: {episode} ({recorded}/{node.num_episodes})", flush=True)
    except KeyboardInterrupt:
        print("\r\033[K", end="", flush=True)  # 상태 줄 지우기
        if recording:  # lerobot 과 달리 저장한다 (위 설명)
            ok, _ = node.call("stop_recording")
            if ok:
                recorded += 1
    finally:
        keys.restore()
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        say("Stop recording", sounds, blocking=True)
        print(f"[keyboard] 이번에 저장한 에피소드: {recorded}개", flush=True)
        close_ros()


if __name__ == "__main__":
    main()
