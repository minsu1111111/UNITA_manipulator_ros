# 리그(PC 별 하드웨어) 설정. 이 파일을 복사해서 채운다 — robot.env 는 깃에 올라가지 않는다.
#   cp config/robot.env.example config/robot.env
# 형식: KEY=VALUE (셸 문법 아님, # 주석). 읽는 코드: lerobot_common/lerobot_common/rig.py
# 확인: ros2 run lerobot_bridge robot --ros-args -p dry_run:=true   (실제로 쓸 포트·카메라·명령이 찍힘)

# 왼쪽·오른쪽 = 로봇 자신의 왼쪽·오른쪽 (로봇 뒤에 서서 로봇과 같은 방향을 볼 때). URDF·RViz 와 같은 기준.
# 리더·팔로워·손목 카메라가 모두 이 기준으로 맞아야 한다. 틀려도 에러는 안 나니 처음 한 번 확인할 것:
#   텔레옵을 띄우고 왼쪽 리더만 움직였을 때 /robot/joint_states 의 left_* 와 left_wrist 영상이 같이 변하는지
#   (데이터를 이미 바뀐 채로 녹화했으면 변환할 때 --swap-arms)

# ---- 팔로워 (1 = 왼팔, 2 = 오른팔) ----------------------------------------------------------------
# *_SERIAL: 보드 USB 시리얼. 있으면 /dev/ttyACM* 중에서 이 보드를 직접 찾아 *_PORT 대신 쓴다 (udev 불필요).
#           보드를 바꾼 적이 있으면 쉼표로 여러 개.  확인: udevadm info -q property -n /dev/ttyACM0 | grep SERIAL_SHORT
# *_PORT  : 시리얼을 못 찾을 때 쓸 포트
LEFT_SERIAL=
LEFT_PORT=/dev/follower1
RIGHT_SERIAL=
RIGHT_PORT=/dev/follower2

# 캘리브레이션 id. lerobot 은 ~/.cache/huggingface/lerobot/calibration/robots/so_follower/<id>.json 을 읽는다.
# 양팔은 "<ROBOT_ID>_left/_right.json" 을 찾으므로, 없으면 CALIB_LEFT/RIGHT 파일을 그 이름으로 복사해 준다.
ROBOT_ID=bimanual
CALIB_LEFT=follower1
CALIB_RIGHT=follower2

# ---- 리더 ---------------------------------------------------------------------------------------
LEADER_LEFT_SERIAL=
LEADER_LEFT_PORT=/dev/leader1
LEADER_RIGHT_SERIAL=
LEADER_RIGHT_PORT=/dev/leader2
LEADER_ID=bimanual_leader
LEADER_CALIB_LEFT=leader1
LEADER_CALIB_RIGHT=leader2

# 캘리브레이션 json 을 받아 둔 폴더 (비우면 HF 캐시만 본다). 캘리는 팔 하드웨어마다 다르므로
# 그 팔을 직접 lerobot-calibrate 한 PC 의 json 만 쓸 것. 예: CALIB_DIR=~/lerobot_pac/calibration
CALIB_DIR=

# ---- lerobot ------------------------------------------------------------------------------------
# lerobot env 의 python. 비우면 자동으로 찾는다 (conda 의 envs/lerobot). 못 찾으면 여기에 적는다.
# 확인: conda activate lerobot && which python
# 로봇 없이 mock 으로만 개발하면 필요 없다.
LEROBOT_PY=

# ---- 카메라 (OpenCV 경로) --------------------------------------------------------------------------
# 비우거나 장치가 없으면 그 카메라 없이 뜬다. 해상도는 학습 데이터와 같게 고정: top 640x480, 손목 320x240, 30fps.
# /dev/videoN 번호는 꽂을 때마다 바뀌므로 고정 경로를 쓴다 (영상은 보통 video-index0):
#   ls -l /dev/v4l/by-id/    카메라 모델·시리얼 기준. 모델이 다른 top 카메라는 이걸로
#   ls -l /dev/v4l/by-path/  꽂은 USB 포트 기준. 같은 모델 손목 카메라 두 대는 이걸로 (항상 같은 허브 포트에 꽂을 것)
# 좌우가 바뀌어도 에러는 안 난다 → 띄운 뒤 rqt_image_view 로 왼손목/오른손목을 눈으로 확인할 것.
TOP_CAM=
LEFT_CAM=
RIGHT_CAM=
# 영상 압축 형식. MJPG 를 권장: 압축 없는 기본(YUYV)은 카메라 여러 대가 한 허브를 나누면 USB 대역폭이 모자라
# 한 대가 프레임을 못 받는다 (에러: 'read thread is not running'). 빈 값 = 카메라 기본
CAM_FOURCC=MJPG
